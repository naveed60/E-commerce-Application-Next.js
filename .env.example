# PostgreSQL. Replace the user, password, host, and port for your environment.
DATABASE_URL=

# Authentication
AUTH_SECRET="replace-with-a-long-random-value"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Optional admin seed override
SEED_ADMIN_PASSWORD="admin123"

# Safepay checkout
SAFEPAY_ENV="sandbox"
SAFEPAY_API_KEY=""
SAFEPAY_MERCHANT_SECRET=""
SAFEPAY_WEBHOOK_SECRET=""
SAFEPAY_WEBHOOK_PREVIOUS_SECRET=""
SAFEPAY_TIMEOUT_MS="15000"

# Transactional email and scheduled commerce jobs
RESEND_API_KEY=""
RESEND_MAX_RETRIES="5"
EMAIL_FROM="NextShop <orders@example.com>"
CRON_SECRET="replace-with-a-long-random-value"

# Vercel Blob (optional; local uploads work without it)
BLOB_READ_WRITE_TOKEN=""
